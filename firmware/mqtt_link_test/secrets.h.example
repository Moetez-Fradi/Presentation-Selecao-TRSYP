#pragma once
// Copy to secrets.h and fill in. secrets.h is git-ignored: never commit it.
// Easiest: dashboard > connection pill > Station (MQTT) > "copy" the secrets.h block.

#define WIFI_SSID     "your-phone-hotspot"   // 2.4 GHz band!
#define WIFI_PASS     "hotspot-password"

// Free public broker, no account (or your own broker's mqtts:// URL on port 8883)
#define MQTT_URI      "mqtts://broker.hivemq.com:8883"
#define MQTT_USER     ""
#define MQTT_PASS     ""

// Must match the dashboard's connection settings exactly
#define STATION_ID    "ds-xxxxxxxxxx"
// Shared secret for signed commands. Required on a public broker: without it anyone
// could start the motor. Remove the line only on a private, password-protected broker.
#define PAIR_KEY      "paste-the-pairing-key-from-the-dashboard"
